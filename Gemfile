source "https://rubygems.org"

# The live site is built by GitHub Pages' own build ("Deploy from a branch"),
# which uses the `github-pages` gem. Using the same gem locally means a site
# that builds here builds identically on GitHub.
gem "github-pages", group: :jekyll_plugins

# Needed by `jekyll serve` on Ruby 3+ (no longer bundled with Ruby).
gem "webrick"
